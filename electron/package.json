{
  "name": "prompt-gate-tray",
  "version": "1.1.1",
  "private": true,
  "description": "Prompt Gate tray app — minimal Electron shell that talks to the Go agent over localhost HTTP.",
  "homepage": "https://github.com/ShieldNet-360/prompt-gate",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShieldNet-360/prompt-gate.git"
  },
  "author": {
    "name": "ShieldNet 360",
    "email": "288552490+brianalle@users.noreply.github.com",
    "url": "https://github.com/ShieldNet-360/prompt-gate"
  },
  "main": "dist/main.js",
  "scripts": {
    "dev": "vite",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main",
    "start": "electron .",
    "package": "npm run build && electron-builder --publish never",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
