[Unit]
Description=Prompt Gate DNS + DLP Agent
Documentation=https://shieldnet360.com
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/prompt-gate-agent --config /etc/prompt-gate/config.yaml
Restart=on-failure
RestartSec=5s

# Binding 127.0.0.1:53 requires the net_bind_service capability without
# running as full root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/prompt-gate /var/log/prompt-gate
StateDirectory=prompt-gate
LogsDirectory=prompt-gate

[Install]
WantedBy=multi-user.target
